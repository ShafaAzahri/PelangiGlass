.git
.github
.gitignore
.gitattributes

# IDE & Editor files
.idea
.vscode
.zed
.cursor
.codex
*.swp
*.swo

# AI & Developer configs
.claude
.mcp.json
boost.json
.ai

# Environment & Secret files
.env
.env.*
!.env.example
auth.json
*.key
*.pem
*.crt
*.pfx
*.p12

# Dependencies (Installed cleanly inside Docker build stages)
node_modules
vendor

# Frontend dev files & builds (compiled in Dockerfile)
public/build
public/hot
public/storage
public/css/filament
public/js/filament
public/fonts/filament

# Storage & Logs (Keep local logs/sessions out of the image)
storage/logs/*
!storage/logs/.gitignore
storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/app/*
!storage/app/public
!storage/app/public/**
!storage/app/.gitignore
storage/inertia-devtools

# Databases & Backups
database/*.sqlite*
*.sql
*.sql.gz
*.dump
*.bak

# Tests & Documentation
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
*.md

# Docker-related files
docker-compose*.yml
Dockerfile*
.dockerignore
